# ============================================================
#  AuromindAI — Backend .env.example
#  Copy to .env and fill in your real values
# ============================================================

PROJECT_NAME=AuromindAI SaaS Platform
VERSION=1.0.0
SECRET_KEY=your-64-char-random-secret-key

ACCESS_TOKEN_EXPIRE_MINUTES=10080

POSTGRES_USER=auromind
POSTGRES_PASSWORD=your-db-password
POSTGRES_SERVER=your-db-host
POSTGRES_PORT=5432
POSTGRES_DB=auromind_db

REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
OPENROUTER_API_KEY=sk-or-...

OLLAMA_BASE_URL=http://localhost:11434
FRONTEND_URL=https://your-frontend.vercel.app
